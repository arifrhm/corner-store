# Public testnet connection. Do not commit credential-bearing RPC URLs.
RPC_URL=
CHAIN_ID=

# Optional explorer source verification. Set only when the target explorer is
# Blockscout-based.
BLOCKSCOUT_API_URL=

# Foundry sender address. Import its key with:
# cast wallet import corner-store-testnet --interactive
CORNER_STORE_TESTNET_DEPLOYER=

# For a hackathon fixture these may equal the deployer. For a production
# deployment use the separate production workflow and an existing Safe.
CORNER_STORE_GOVERNANCE=
CORNER_STORE_OPERATOR=

# Externally controlled demo wallets. The maker and investors approve the RFQ
# adapter in separate transactions after deployment.
CORNER_STORE_TESTNET_MAKER=
CORNER_STORE_TESTNET_INVESTOR=
CORNER_STORE_TESTNET_INVESTOR_B=
CORNER_STORE_TESTNET_INELIGIBLE_INVESTOR=
# Optional fourth judge scene. This wallet receives an intentionally stale mock
# QP claim while retaining valid test identity wiring.
# CORNER_STORE_TESTNET_EXPIRED_INVESTOR=

# Optional display-only token identity. The underlying policy profile remains
# BUIDL-like; the public Monad hackathon demo uses a neutral fictional name.
# CORNER_STORE_TESTNET_TOKEN_NAME=Demo Restricted Security
# CORNER_STORE_TESTNET_TOKEN_SYMBOL=DRS

# Optional hackathon scene. When true, investor B receives valid acquisition
# evidence whose 365-day resale clock starts at deployment. Buy flows and all
# other actors retain the existing fixture behavior.
# CORNER_STORE_TESTNET_INVESTOR_B_HOLDING_PERIOD_PENDING=true

# Ephemeral mock Trusted Issuer signing key used only to construct test
# ONCHAINID claims. Generate it securely and never commit the value.
CORNER_STORE_TESTNET_ISSUER_KEY=

# Optional deployment metadata.
CORNER_STORE_DEPLOYMENT_ID=hackathon-testnet-rfq

# Separate public-testnet demo runtime. The Maker key must be a disposable
# testnet-only key matching CORNER_STORE_TESTNET_MAKER.
CORNER_STORE_TESTNET_ARTIFACT=deployments/public/hackathon-testnet-rfq-<chain-id>.json
CORNER_STORE_TESTNET_RPC_URL=
CORNER_STORE_TESTNET_EXPLORER_URL=
# For non-Monad browser-wallet setup, either leave all four unset or provide all
# four. The public wallet RPC must not contain credentials and is kept separate
# from CORNER_STORE_TESTNET_RPC_URL.
# CORNER_STORE_TESTNET_WALLET_NETWORK_NAME=
# CORNER_STORE_TESTNET_WALLET_RPC_URL=
# CORNER_STORE_TESTNET_WALLET_NATIVE_CURRENCY=
# CORNER_STORE_TESTNET_WALLET_EXPLORER_URL=
CORNER_STORE_TESTNET_MAKER_KEY=
# Container hosting should prefer a read-only secret file instead of the direct
# variable above: CORNER_STORE_TESTNET_MAKER_KEY_FILE=/run/secrets/maker_key
CORNER_STORE_TESTNET_DEMO_HOST=127.0.0.1
CORNER_STORE_TESTNET_DEMO_PORT=8791
CORNER_STORE_TESTNET_PRICE_NUMERATOR=1
CORNER_STORE_TESTNET_PRICE_DENOMINATOR=1
# Required only when binding the demo outside loopback. This explicit value
# confirms the service is a disposable hackathon testnet fixture, not production.
# CORNER_STORE_TESTNET_PUBLIC_ACKNOWLEDGEMENT=hackathon-testnet-only
# Global backend requests per minute for /health and /api/*. Defaults to 240
# and is capped at 10000. The HTTPS edge should apply its own client-aware limit.
# CORNER_STORE_TESTNET_API_REQUESTS_PER_MINUTE=240
# Global signed-quote requests per minute. Defaults to 20 and is capped at 1000.
# CORNER_STORE_TESTNET_QUOTE_REQUESTS_PER_MINUTE=20
# JSON-RPC requests per second sent to CORNER_STORE_TESTNET_RPC_URL, paced to stay
# under the RPC provider's limit (the public Monad RPC allows 15/sec). Defaults to
# 10 and is capped at 1000.
# CORNER_STORE_TESTNET_RPC_REQUESTS_PER_SECOND=10
# Defaults to deployments/public/<deployment-id>-<chain-id>.json on broadcast.
# CORNER_STORE_ARTIFACT=

# Optional initial inventory in 18-decimal base units.
# CORNER_STORE_TESTNET_INVESTOR_QUOTE=
# CORNER_STORE_TESTNET_INVESTOR_RWA=
# CORNER_STORE_TESTNET_MAKER_QUOTE=
# CORNER_STORE_TESTNET_MAKER_RWA=
